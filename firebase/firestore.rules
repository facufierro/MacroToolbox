rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /MacroToolboxDB/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string;
      match /snapshots/{revision} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly(['payload'])
          && request.resource.data.payload is string;
        match /chunks/{chunk} {
          allow read, delete: if owns(uid);
          allow create: if owns(uid)
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 699052;
          // Uploaded content is immutable until deleted during cleanup.
          allow update: if false;
        }
      }
    }
  }
}
